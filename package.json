    "handlebars": "^4.7.8",
    "helmet": "^8.0.0",
    "http-status": "^1.6.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.2",
    "moment": "^2.30.1",
    "mongoose": "^8.9.3",
    "multer": "^1.4.5-lts.1",
    "node-cache": "^5.1.2",
    "nodemailer": "^7.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "sharp": "^0.34.5",
