    "@types/passport": "^1.0.17",
    "@types/passport-jwt": "^4.0.1",
    "@types/sanitize-html": "^2.16.0",
    "@types/validator": "^13.12.2",
    "cpx": "^1.5.0",
    "rimraf": "^6.1.2",
